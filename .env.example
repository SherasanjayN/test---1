# Copy this file to .env and replace every placeholder before deploying.
PORT=5008
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional first-run Super Admin bootstrap (uncomment and replace all values).
# INITIAL_SUPER_ADMIN_NAME=
# INITIAL_SUPER_ADMIN_EMAIL=
# INITIAL_SUPER_ADMIN_PHONE=
# INITIAL_SUPER_ADMIN_PASSWORD=

# Optional; SHE AI stays disabled until configured.
GEMINI_API_KEY=replace-with-your-server-side-gemini-api-key
